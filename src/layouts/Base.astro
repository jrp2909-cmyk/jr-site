---
import '../styles/global.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import Migalhas from '../components/Migalhas.astro';
import Efeitos from '../components/Efeitos.astro';
import { organizacao, website, migalhas as migalhasLd } from '../lib/schema';
import { SITE_NOME } from '../data/site';

interface Props {
  titulo: string;
  descricao: string;
  og?: string; // caminho da imagem de compartilhamento (padrao /og.jpg)
  ogAlt?: string;
  schema?: (Record<string, unknown> | null)[];
  migalhas?: { nome: string; href: string }[];
  tipo?: 'website' | 'article';
  noindex?: boolean;
}
const { titulo, descricao, og = '/og.jpg', ogAlt = 'JR! – CRM de social selling', schema = [], migalhas, tipo = 'website', noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(og, Astro.site).href;

const grafo = {
  '@context': 'https://schema.org',
  '@graph': [organizacao(), website(), ...(migalhas ? [migalhasLd(migalhas)] : []), ...schema.filter(Boolean)],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#02060F" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href="/icone-256.png" />
    <link rel="apple-touch-icon" href="/icone-256.png" />
    <link rel="alternate" type="application/rss+xml" title="Conteúdo do JR!" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE_NOME} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      {migalhas && <Migalhas itens={migalhas} />}
      <slot />
    </main>
    <Rodape />
    <Efeitos />
  </body>
</html>
