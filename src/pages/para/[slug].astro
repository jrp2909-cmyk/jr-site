---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Icone from '../../components/Icone.astro';
import Faq from '../../components/Faq.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { NOTA } from '../../data/site';
import { faqPage, software } from '../../lib/schema';

export async function getStaticPaths() {
  const lista = await getCollection('para');
  return lista.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const funcs = await getCollection('funcionalidades');
const destaque = d.funcionalidades.map((s) => funcs.find((x) => x.id === s)).filter((x) => !!x);
const url = `/para/${p.id}/`;
---
<Base
  titulo={d.seoTitulo}
  descricao={d.descricao}
  og={`/og/para-${p.id}.jpg`}
  ogAlt={d.titulo}
  migalhas={[{ nome: 'Início', href: '/' }, { nome: 'Para quem', href: '/para/' }, { nome: d.nome, href: url }]}
  schema={[software(d.descricao, url), faqPage(d.faq)]}
>
  <section class="pg-hero">
    <div class="fundo-grade" aria-hidden="true"></div>
    <div class="container pg-hero-grid">
      <div>
        <p class="eyebrow"><Icone nome={d.icone as any} class="eyebrow-ic" /> Para {d.nome.toLowerCase()}</p>
        <h1>{d.titulo}</h1>
        <p class="lead">{d.descricao}</p>
        <div class="hero-acoes esq">
          <a class="btn btn-primario" href="/fundadores/">Quero ser fundador <Icone nome="arrow" /></a>
          <a class="btn btn-sec" href="/#teste">Teste o JR!</a>
        </div>
      </div>
      <figure class="pg-hero-img">
        <div class="moldura"><Shot src={d.imagem} alt={d.imagemAlt} eager widths={[640, 960, 1400]} sizes="(min-width: 1100px) 600px, 100vw" /></div>
        <figcaption class="nota-ficticia">{NOTA}</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec-alt">
    <div class="container">
      <div class="sec-cabeca"><p class="eyebrow">Você conhece isso</p><h2>O que trava a prospecção hoje</h2></div>
      <ul class="dores">
        {d.dores.map((x) => <li class="cartao"><Icone nome="x" />{x}</li>)}
      </ul>
    </div>
  </section>

  <section>
    <div class="container prosa"><Content /></div>
  </section>

  <section class="sec-alt">
    <div class="container">
      <div class="sec-cabeca"><p class="eyebrow">As funcionalidades que mais ajudam</p><h2>Feito para a sua rotina</h2></div>
      <div class="grade g4">
        {destaque.map((f) => (
          <a class="cartao brilho" href={`/funcionalidades/${f.id}/`}>
            <div class="icone"><Icone nome={f.data.icone as any} /></div>
            <h3>{f.data.nome}</h3>
            <p>{f.data.resumo}</p>
            <span class="link-seta">Ver detalhes <Icone nome="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq itens={d.faq} />
  <CtaFinal mensagem={`Olá, Junior! Vi a página do JR! para ${d.nome.toLowerCase()} e quero conhecer.`} />
</Base>
