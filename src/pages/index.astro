---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import { Image } from 'astro:assets';

import logo from '../assets/brand/logo-compact.png';
import logoCompleta from '../assets/brand/logo.png';

import dashboard from '../assets/desktop/01-dashboard.png';
import graficos from '../assets/desktop/02-dashboard-graficos-e-tarefas.png';
import funil from '../assets/desktop/03-funil.png';
import funilQuente from '../assets/desktop/04-funil-filtro-termometro-quente.png';
import tarefas from '../assets/desktop/08-tarefas.png';
import escreverIA from '../assets/desktop/07-empresa-escrever-com-ia.png';
import radar from '../assets/desktop/09-radar.png';
import projeto from '../assets/desktop/10-projeto-contexto-e-funil-sugerido.png';
import cadencias from '../assets/desktop/11-cadencias.png';
import assistente from '../assets/desktop/14-assistente-ia.png';
import extensao from '../assets/desktop/40-extensao-popup.png';
import relSimples from '../assets/desktop/rel-simples-topo.png';
import relMedio from '../assets/desktop/rel-medio-topo.png';
import relDetalhado from '../assets/desktop/rel-detalhado-topo.png';
import relEscolha from '../assets/desktop/12-relatorios-escolha.png';

import termoEmpresa from '../assets/recortes/termometro-topo.png';
import termoFaixas from '../assets/recortes/termometro-filtro-faixas.png';
import comissao from '../assets/recortes/card-comissao.png';

import m1 from '../assets/mobile/30-mobile-dashboard.png';
import m2 from '../assets/mobile/31-mobile-funil.png';
import m3 from '../assets/mobile/32-mobile-tarefas.png';

const WHATS = 'https://wa.me/5548999735087?text=' + encodeURIComponent('Olá, Junior! Vi o site do JR! e quero conhecer o CRM.');
const LINKEDIN = 'https://www.linkedin.com/in/juniorpereira-/';
const NOTA = 'Imagens com dados fictícios de demonstração.';

const ic = {
  bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  table: '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  file: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8M16 13H8M16 17H8"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  crown: '<path d="M3 20h18M5 16 3 6l5 4 4-6 4 6 5-4-2 10Z"/>',
  chart: '<path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/>',
  phone: '<rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
};

const problemas = [
  { i: 'bell', t: 'A conexão foi aceita e ninguém falou com a pessoa.', d: 'Follow-up esquecido é oportunidade perdida.' },
  { i: 'table', t: 'Planilha não entende de relacionamento.', d: 'Pessoa vira linha, e linha não esquenta.' },
  { i: 'search', t: 'Qual lead merece atenção hoje?', d: 'Sem resposta clara, o dia vai embora.' },
  { i: 'file', t: 'Relatório para a diretoria toma uma tarde.', d: 'E já nasce desatualizado.' },
];

const passos = [
  { t: 'Conecte e cadastre.', d: 'Empresas e pessoas entram no funil, com o contexto do seu cliente.' },
  { t: 'O JR! sugere.', d: 'Termômetro, tarefas do dia, radar do LinkedIn e mensagens prontas para revisar.' },
  { t: 'Você decide.', d: 'Envia do seu jeito, registra e acompanha a relação esquentar.' },
];

const sizesCard = '(min-width: 1180px) 570px, (min-width: 800px) 48vw, 100vw';
const funcs = [
  { img: funil, alt: 'Funil de prospecção em colunas com cartões de empresas e temperatura', t: 'Funil que se move sozinho', d: 'Conexão aceita ou resposta recebida, e a empresa muda de etapa.' },
  { img: tarefas, alt: 'Quadro de tarefas atrasadas, de hoje e dos próximos dias', t: 'Tarefas que nascem sozinhas', d: 'E-mail preenchido, reunião feita, conexão aceita: o próximo passo já está na sua lista.' },
  { img: escreverIA, alt: 'Painel de IA do JR! com três versões de mensagem personalizadas', t: 'IA com o contexto do cliente', d: 'Três versões de DM, e-mail ou WhatsApp, no tom certo. Você revisa.' },
  { img: radar, alt: 'Radar de novidades dos leads com sugestão de interação', t: 'Radar do LinkedIn', d: 'Posts e mudanças dos seus leads, com sugestão de como interagir. Só leitura.' },
  { img: assistente, alt: 'Assistente do JR! respondendo perguntas sobre os dados', t: 'Assistente que conhece seus dados', d: 'Pergunte “quais são as mais quentes?” e receba a resposta em segundos. Ele só lê, nunca altera.' },
  { img: cadencias, alt: 'Cadência multicanal com sete toques entre LinkedIn, e-mail, WhatsApp e reunião', t: 'Cadências multicanal', d: 'Sequências de toques por LinkedIn, e-mail, WhatsApp e reunião, com mensagens-modelo.' },
  { img: projeto, alt: 'Página de um projeto no JR! com contexto do cliente e sugestões da IA', t: 'Vários clientes, um só lugar', d: 'Cada projeto com funil, cadência, contexto e relatórios próprios.' },
  { img: comissao, alt: 'Cartão de comissão do mês com a regra do projeto', t: 'Comissão sob controle', d: 'Regra por projeto (percentual, fixo, faixas) e acompanhamento do mês.', recorte: true },
];

const personas = [
  { i: 'crown', p: 'CEOs e donos', d: 'Veja o que está acontecendo na prospecção sem abrir o sistema: relatório pronto, claro e sem planilha.' },
  { i: 'chart', p: 'Gestores comerciais', d: 'Funil real, esforço medido e quem está quente. Cobre com dados.' },
  { i: 'phone', p: 'Profissionais de vendas', d: 'Saiba a quem falar hoje, nunca esqueça um follow-up e escreva mais rápido sem perder a voz.' },
  { i: 'users', p: 'Freelancers e PJs de pré-vendas', d: 'Atenda vários clientes sem misturar nada, com contexto, funil e relatórios por cliente.' },
];

const seguranca = [
  { i: 'check', t: 'A IA sugere, você decide.', d: 'Nenhuma mensagem é enviada sozinha.' },
  { i: 'eye', t: 'A extensão só lê.', d: 'Não curte, não comenta, não envia. Acompanha só os perfis que você cadastrou, em ritmo humano.' },
  { i: 'lock', t: 'Seus dados, só seus.', d: 'Cada conta enxerga apenas o que é dela, com controle de acesso no banco de dados e conexão criptografada.' },
  { i: 'shield', t: 'Auditado.', d: 'Verificamos controle de acesso, injeção de código e cabeçalhos de segurança.' },
];

const faq = [
  ['O JR! envia mensagens por mim?', 'Não. Ele sugere textos e tarefas. Quem revisa e envia é você, no seu canal.'],
  ['Existe risco para a minha conta do LinkedIn?', 'A extensão foi desenhada para apenas ler, em ritmo humano, com limite diário e sem executar ações. Ainda assim, o LinkedIn pode mudar suas regras, e o uso é de responsabilidade de cada pessoa. Dá para usar o JR! sem a extensão.'],
  ['Preciso da extensão do Chrome?', 'Não. Ela alimenta o Radar e marca as conexões aceitas, mas o resto funciona sem ela.'],
  ['Quais canais o JR! suporta?', 'LinkedIn, e-mail, WhatsApp e reunião (Meet ou Teams). Por padrão, a cadência não usa ligação.'],
  ['Serve para mais de um cliente?', 'Sim. Cada projeto tem funil, cadência, contexto, campanhas e relatórios próprios.'],
  ['Funciona no celular?', 'Sim, o sistema é responsivo e tem menu próprio para o celular.'],
  ['Quanto custa? Posso usar?', 'O JR! ainda não está disponível publicamente. Chame no WhatsApp para conhecer e entrar na lista de espera.'],
  ['Onde ficam meus dados?', 'Em banco de dados na nuvem, com acesso separado por conta e conexão criptografada.'],
];

const faixas = [
  ['Gelado', 'var(--jr-gelado)'], ['Morno', 'var(--jr-morno)'], ['Aquecendo', 'var(--jr-aquecendo)'],
  ['Quente', 'var(--jr-quente)'], ['Em brasa', 'var(--jr-em-brasa)'],
];

const zap = '<path fill="currentColor" fill-rule="evenodd" stroke="none" d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.8-.7-1.4-1.6-1.6-1.9-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15L2 22l5.1-1.3A10 10 0 1 0 12 2z"/>';
---
<Base
  titulo="JR! — CRM de social selling | Transforme conexões em reuniões"
  descricao="CRM de social selling com termômetro de relacionamento, IA que escreve com o contexto do cliente, radar do LinkedIn e relatórios em um clique."
>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>

  <header class="topo">
    <div class="container topo-in">
      <a class="logo-link" href="#topo" aria-label="JR! – Just Relationship CRM, início">
        <Image src={logo} alt="JR!" height={76} loading="eager" />
      </a>
      <nav class="nav" aria-label="Principal">
        <a href="#como-funciona">Como funciona</a>
        <a href="#funcionalidades">Funcionalidades</a>
        <a href="#termometro">Termômetro</a>
        <a href="#relatorios">Relatórios</a>
        <a href="#seguranca">Segurança</a>
        <a href="#faq">Perguntas</a>
        <a class="btn btn-primario" href={WHATS} target="_blank" rel="noopener">Quero conhecer</a>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero" id="topo">
      <div class="container">
        <div class="hero-txt">
          <p class="eyebrow">Relacionamento desde o 1º contato</p>
          <h1>Transforme conexões em <em>reuniões.</em></h1>
          <p class="sub">O JR! mede a temperatura de cada relação, cria sozinho o próximo passo e escreve as mensagens com IA. Você revisa, decide e fecha. Nada é enviado sem você.</p>
          <div class="hero-acoes">
            <a class="btn btn-primario" href={WHATS} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={zap} />
              </svg>
              Quero conhecer
            </a>
            <a class="btn btn-sec" href="#video">Ver em ação</a>
          </div>
          <p class="hero-nota"><b>Criado e usado todos os dias</b> por um profissional de pré-vendas.</p>
        </div>
        <div class="hero-quadro">
          <div class="moldura">
            <div class="moldura-barra" aria-hidden="true"><i></i><i></i><i></i></div>
            <Shot src={dashboard} eager widths={[640, 960, 1280, 1800, 2400]} sizes="(min-width: 1180px) 1140px, calc(100vw - 40px)" alt="Painel do JR! com metas do dia, termômetro das empresas, indicadores e comissão do mês" />
          </div>
          <p class="nota-ficticia">Seu dia em um painel. {NOTA}</p>
        </div>
      </div>
    </section>

    <section id="problema" class="sec-alt">
      <div class="container">
        <div class="sec-cabeca">
          <p class="eyebrow">O problema</p>
          <h2>Vender por relacionamento sem perder o fio.</h2>
        </div>
        <div class="grade g4">
          {problemas.map((p) => (
            <article class="cartao">
              <div class="icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic[p.i]}></svg></div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-funciona">
      <div class="container">
        <div class="sec-cabeca">
          <p class="eyebrow">Como funciona</p>
          <h2 class="passos-h2"><span>Conecte.</span> <span>O JR! sugere.</span> <span>Você decide.</span></h2>
        </div>
        <div class="grade g3">
          {passos.map((p, i) => (
            <article class="cartao passo">
              <div class="num">0{i + 1}</div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="video" class="sec-alt">
      <div class="container">
        <div class="sec-cabeca centro">
          <p class="eyebrow">Ver em ação</p>
          <h2>Um minuto para entender o JR!</h2>
        </div>
        <div class="video-wrap">
          <div class="moldura">
            <video controls preload="metadata" poster="/media/poster.webp" playsinline>
              <source src="/media/jr-demo.mp4" type="video/mp4" />
              <track kind="captions" src="/media/legendas.vtt" srclang="pt-BR" label="Português" />
              Seu navegador não reproduz vídeo. <a href="/media/jr-demo.mp4">Baixe o vídeo de demonstração</a>.
            </video>
          </div>
          <p class="video-legenda">Vídeo com narração e trilha musical. {NOTA}</p>
        </div>
      </div>
    </section>

    <section id="funcionalidades">
      <div class="container">
        <div class="sec-cabeca">
          <p class="eyebrow">Funcionalidades</p>
          <h2>Tudo o que a rotina de social selling pede, num só lugar.</h2>
        </div>
        <div class="grade g-func">
          {funcs.map((f) => (
            <article class="cartao func">
              <div class:list={['func-img', { recorte: f.recorte }]}>
                <Shot src={f.img} alt={f.alt} widths={f.recorte ? [480, 752] : [768, 1100, 1600]} sizes={f.recorte ? '400px' : '(min-width: 1180px) 680px, (min-width: 600px) 60vw, 117vw'} />
              </div>
              <div class="func-corpo">
                <h3>{f.t}</h3>
                <p>{f.d}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="nota-ficticia">{NOTA}</p>
      </div>
    </section>

    <section id="termometro" class="sec-alt">
      <div class="container termo">
        <div>
          <p class="eyebrow">O diferencial</p>
          <h2>Termômetro de relacionamento.</h2>
          <p class="lead">Uma nota de 0 a 100 para cada empresa e pessoa, em 5 faixas. Cada passo da relação vira pontos. Clique numa faixa e Funil, Empresas, Leads, Tarefas e Radar mostram só aquela temperatura.</p>
          <ul class="faixas">
            {faixas.map(([n, c]) => (
              <li><span class="bola" style={`background:${c}`} aria-hidden="true"></span><b>{n}</b></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="termo-imgs">
            <div class="col">
              <div class="moldura"><Shot src={termoEmpresa} widths={[400, 752]} sizes="(min-width: 960px) 260px, 80vw" alt="Ficha da empresa com o termômetro de relacionamento e os passos conquistados" /></div>
            </div>
            <div class="col">
              <div class="moldura"><Shot src={funilQuente} widths={[480, 768, 1100]} sizes="(min-width: 960px) 480px, 100vw" alt="Funil filtrado pela faixa Quente do termômetro" /></div>
              <div class="termo-faixas"><Shot src={termoFaixas} widths={[480, 1126]} sizes="(min-width: 960px) 480px, 100vw" alt="As cinco faixas clicáveis do termômetro, com a contagem de empresas em cada uma" /></div>
            </div>
          </div>
          <p class="legenda">Clique em Quente e veja só quem merece atenção. {NOTA}</p>
        </div>
      </div>
    </section>

    <section id="dispositivos">
      <div class="container">
        <div class="sec-cabeca centro">
          <p class="eyebrow">Onde você estiver</p>
          <h2>No computador e no celular.</h2>
          <p class="lead">O sistema é responsivo, com menu próprio no celular. Acompanhe a prospecção de onde estiver.</p>
        </div>
        <div class="celulares">
          <div class="celular"><Shot src={m1} widths={[320, 500]} sizes="250px" alt="Painel do JR! no celular, com o menu fixo embaixo" /></div>
          <div class="celular"><Shot src={m2} widths={[320, 500]} sizes="250px" alt="Funil com termômetro no celular" /></div>
          <div class="celular"><Shot src={m3} widths={[320, 500]} sizes="250px" alt="Tarefas do dia no celular" /></div>
        </div>
        <p class="nota-ficticia">{NOTA}</p>
      </div>
    </section>

    <section id="para-quem" class="sec-alt">
      <div class="container">
        <div class="sec-cabeca">
          <p class="eyebrow">Para quem é</p>
          <h2>Quem decide, quem vende e quem atende vários clientes.</h2>
        </div>
        <div class="grade g4">
          {personas.map((p) => (
            <article class="cartao persona">
              <div class="icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic[p.i]}></svg></div>
              <h3>{p.p}</h3>
              <p>{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="relatorios">
      <div class="container">
        <div class="sec-cabeca">
          <p class="eyebrow">Relatórios</p>
          <h2>Prestação de contas em um clique.</h2>
          <p class="lead">Três níveis de detalhe, em PDF ou em texto para WhatsApp e e-mail. Os relatórios nunca mostram comissão.</p>
        </div>
        <div class="grade g3">
          <article class="cartao rel">
            <div class="rel-img"><Shot src={relSimples} widths={[480, 768]} sizes="(min-width: 1180px) 380px, 100vw" alt="Relatório simplificado de prospecção" /></div>
            <div class="func-corpo"><span class="tag">Simplificado</span><h3>Para CEOs</h3><p>Uma página, direto ao ponto.</p></div>
          </article>
          <article class="cartao rel">
            <div class="rel-img"><Shot src={relMedio} widths={[480, 768]} sizes="(min-width: 1180px) 380px, 100vw" alt="Relatório médio com gráficos e empresas mais engajadas" /></div>
            <div class="func-corpo"><span class="tag">Médio</span><h3>Para gestores comerciais</h3><p>Evolução, termômetro, canais e reuniões.</p></div>
          </article>
          <article class="cartao rel">
            <div class="rel-img"><Shot src={relDetalhado} widths={[480, 768]} sizes="(min-width: 1180px) 380px, 100vw" alt="Relatório detalhado com funil, conexões, dores e próximos passos" /></div>
            <div class="func-corpo"><span class="tag">Detalhado</span><h3>Para quem acompanha de perto</h3><p>Funil, conexões, dores e próximos passos.</p></div>
          </article>
        </div>
        <p class="nota-ficticia">{NOTA}</p>
      </div>
    </section>

    <section id="seguranca" class="sec-alt">
      <div class="container seg">
        <div>
          <p class="eyebrow">Segurança e privacidade</p>
          <h2>Você no comando.</h2>
          <p class="lead">A IA e a extensão só sugerem. Nada é enviado, curtido ou comentado automaticamente, o que protege a sua conta do LinkedIn e o seu tom pessoal.</p>
          <ul class="seg-lista">
            {seguranca.map((s) => (
              <li>
                <div class="icone"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ic[s.i]}></svg></div>
                <div><h3>{s.t}</h3><p>{s.d}</p></div>
              </li>
            ))}
          </ul>
        </div>
        <div class="seg-img">
          <div class="moldura"><Shot src={extensao} widths={[480, 960]} sizes="380px" alt="Janela da extensão JR! Radar com o contador de leituras do dia" /></div>
          <p class="legenda">A extensão JR! Radar: leitura apenas, com limite diário. {NOTA}</p>
        </div>
      </div>
    </section>

    <section id="criador">
      <div class="container">
        <div class="criador">
          <div class="avatar" aria-hidden="true">JP<span>!</span></div>
          <div>
            <p class="eyebrow">Quem criou</p>
            <h2>Feito por quem usa todos os dias.</h2>
            <p>Sou profissional de pré-vendas (PJ) e atendo vários clientes ao mesmo tempo, prospectando por social selling: LinkedIn, e-mail, WhatsApp e reunião. Planilhas e CRMs tradicionais não davam conta de relacionamento antes de pipeline, de vários clientes no mesmo lugar nem da rotina diária de toques. Então eu criei o JR!, e uso todos os dias.</p>
            <p class="nome">Junior Pereira · Pré-vendas · <a class="link" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="sec-alt">
      <div class="container">
        <div class="sec-cabeca centro">
          <p class="eyebrow">Perguntas frequentes</p>
          <h2>Perguntas frequentes.</h2>
        </div>
        <div class="faq">
          {faq.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

