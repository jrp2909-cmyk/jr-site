---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import Icone from '../components/Icone.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import VideoFacade from '../components/VideoFacade.astro';
import HeroVivo from '../components/demo/HeroVivo.astro';
import DemoIA from '../components/demo/DemoIA.astro';
import TermometroJogavel from '../components/demo/TermometroJogavel.astro';
import AssistenteDemo from '../components/demo/AssistenteDemo.astro';
import RelatorioAbas from '../components/demo/RelatorioAbas.astro';
import { LINKEDIN, NOTA } from '../data/site';
import { faqPage, software, video } from '../lib/schema';

import m1 from '../assets/mobile/30-mobile-dashboard.png';
import m2 from '../assets/mobile/31-mobile-funil.png';
import m3 from '../assets/mobile/32-mobile-tarefas.png';

const funcs = (await getCollection('funcionalidades')).sort((a, b) => a.data.ordem - b.data.ordem);
const publicos = (await getCollection('para')).sort((a, b) => a.data.ordem - b.data.ordem);

const descricao = 'CRM de social selling com termômetro de relacionamento, IA que escreve com o contexto do cliente, radar do LinkedIn e relatórios em um clique.';

const problemas = [
  { i: 'bell', t: 'A conexão foi aceita e ninguém falou com a pessoa.', d: 'Follow-up esquecido é oportunidade perdida.' },
  { i: 'table', t: 'Planilha não entende de relacionamento.', d: 'Pessoa vira linha, e linha não esquenta.' },
  { i: 'search', t: 'Qual lead merece atenção hoje?', d: 'Sem resposta clara, o dia vai embora.' },
  { i: 'file', t: 'Relatório para a diretoria toma uma tarde.', d: 'E já nasce desatualizado.' },
] as const;

const passos = [
  { t: 'Conecte e cadastre.', d: 'Empresas e pessoas entram no funil com o contexto do seu cliente: oferta, tom, ICP e dores. O JR! diz o que falta para começar.' },
  { t: 'O JR! sugere.', d: 'O termômetro mede cada relação, as tarefas nascem dos eventos, o Radar traz motivos reais para falar e a IA escreve três versões.' },
  { t: 'Você decide.', d: 'Você revisa, envia do seu jeito e registra. A relação esquenta, o funil se move sozinho e o relatório fica pronto.' },
];

const faq = [
  { q: 'O JR! envia mensagens por mim?', a: 'Não. Ele sugere textos e tarefas. Quem revisa e envia é você, no seu canal.' },
  { q: 'Existe risco para a minha conta do LinkedIn?', a: 'A extensão foi desenhada para apenas ler, em ritmo humano, com limite diário e sem executar ações. Ainda assim, o LinkedIn pode mudar suas regras, e o uso é de responsabilidade de cada pessoa. Dá para usar o JR! sem a extensão.' },
  { q: 'Preciso da extensão do Chrome?', a: 'Não. Ela alimenta o Radar e marca as conexões aceitas, mas o resto funciona sem ela.' },
  { q: 'Quais canais o JR! suporta?', a: 'LinkedIn, e-mail, WhatsApp e reunião (Meet ou Teams). Por padrão, a cadência não usa ligação.' },
  { q: 'Serve para mais de um cliente?', a: 'Sim. Cada projeto tem funil, cadência, contexto, campanhas e relatórios próprios.' },
  { q: 'Funciona no celular?', a: 'Sim, o sistema é responsivo e tem menu próprio para o celular.' },
  { q: 'Quanto custa? Posso usar?', a: 'O JR! está abrindo as primeiras vagas para clientes fundadores, com acesso antecipado e condição especial. Inscreva-se na página Fundadores ou chame o Junior no WhatsApp.' },
  { q: 'Onde ficam meus dados?', a: 'Em banco de dados na nuvem, com acesso separado por conta e conexão criptografada.' },
];
---
<Base
  titulo="JR! — CRM de social selling | Transforme leads em relacionamentos"
  descricao={descricao}
  schema={[software(descricao), faqPage(faq), video()]}
>
  <section class="hero" id="topo">
    <div class="fundo-grade" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-txt">
        <a class="selo" href="/fundadores/"><span class="pulso" aria-hidden="true"></span>Vagas abertas para clientes fundadores <Icone nome="arrow" /></a>
        <h1>Transforme leads em <em>relacionamentos</em> que vendem.</h1>
        <p class="sub">Social selling com IA para times comerciais. O JR! mede a temperatura de cada relação, cria sozinho o próximo passo e escreve as mensagens com o contexto do seu cliente. Você revisa, decide e fecha.</p>
        <div class="hero-acoes">
          <a class="btn btn-primario" href="#teste">Teste o JR! agora <Icone nome="arrow" /></a>
          <a class="btn btn-sec" href="/fundadores/">Seja cliente fundador</a>
        </div>
        <ul class="hero-provas">
          <li><Icone nome="check" />Nada é enviado sem você</li>
          <li><Icone nome="eye" />Extensão só leitura</li>
          <li><Icone nome="users" />Vários clientes, um só lugar</li>
        </ul>
      </div>
      <div class="hero-demo">
        <HeroVivo />
      </div>
    </div>
  </section>

  <section id="problema" class="sec-alt">
    <div class="container">
      <div class="sec-cabeca">
        <p class="eyebrow">O problema</p>
        <h2>Vender por relacionamento sem perder o fio.</h2>
      </div>
      <div class="grade g4">
        {problemas.map((p, k) => (
          <article class="cartao brilho" data-revela style={`--atraso:${k * 70}ms`}>
            <div class="icone"><Icone nome={p.i} /></div>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="como-funciona">
    <div class="container">
      <div class="sec-cabeca">
        <p class="eyebrow">Como funciona</p>
        <h2 class="passos-h2"><span>Conecte.</span> <span>O JR! sugere.</span> <span>Você decide.</span></h2>
      </div>
      <ol class="linha-passos" data-passos-scroll>
        {passos.map((p, i) => (
          <li class="lp" data-revela style={`--atraso:${i * 120}ms`}>
            <span class="lp-num">0{i + 1}</span>
            <div><h3>{p.t}</h3><p>{p.d}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="teste" class="sec-alt sec-destaque">
    <div class="container">
      <div class="sec-cabeca centro">
        <p class="eyebrow">Teste o JR!</p>
        <h2>Veja a IA escrever com contexto, não com modelo pronto.</h2>
        <p class="lead">Escolha um lead e um canal. O JR! lê o contexto do cliente, o momento da relação e o último post, e entrega três abordagens diferentes para você escolher.</p>
      </div>
      <DemoIA />
      <p class="nota-ficticia">Demonstração com dados e mensagens fictícios, sem enviar nada a lugar nenhum. <a class="link" href="/funcionalidades/ia-para-mensagens-de-prospeccao/">Como a IA do JR! funciona</a></p>
    </div>
  </section>

  <section id="termometro">
    <div class="container termo2">
      <div>
        <p class="eyebrow">O diferencial</p>
        <h2>Termômetro de relacionamento. Experimente.</h2>
        <p class="lead">Uma nota de 0 a 100 para cada empresa e pessoa, em 5 faixas. Cada passo conquistado vira pontos, e o JR! sempre diz qual é o próximo. Marque os passos ao lado e veja a relação esquentar.</p>
        <p class="lead">No sistema, clique numa faixa e o funil, as empresas, os leads, as tarefas e o radar mostram só aquela temperatura.</p>
        <a class="link-seta" href="/funcionalidades/termometro-de-relacionamento/">Entenda o termômetro <Icone nome="arrow" /></a>
      </div>
      <TermometroJogavel />
    </div>
  </section>

  <section id="funcionalidades" class="sec-alt">
    <div class="container">
      <div class="sec-cabeca">
        <p class="eyebrow">Funcionalidades</p>
        <h2>Tudo o que a rotina de social selling pede, num só lugar.</h2>
      </div>
      <div class="bento">
        {funcs.map((f, k) => (
          <a class:list={['bento-item', 'brilho', { 'bento-grande': k < 2 }]} href={`/funcionalidades/${f.id}/`} data-revela style={`--atraso:${(k % 4) * 60}ms`}>
            <div class="bento-txt">
              <span class="icone"><Icone nome={f.data.icone as any} /></span>
              <h3>{f.data.nome}</h3>
              <p>{f.data.resumo}</p>
              <span class="link-seta">Ver detalhes <Icone nome="arrow" /></span>
            </div>
            {k < 4 && (
              <div class:list={['bento-img', { recorte: f.data.recorte }]}>
                <Shot src={f.data.imagem} alt={f.data.imagemAlt} widths={[480, 768, 1100]} sizes={k < 2 ? '(min-width: 1180px) 560px, 100vw' : '(min-width: 1180px) 280px, 100vw'} />
              </div>
            )}
          </a>
        ))}
      </div>
      <p class="nota-ficticia">{NOTA}</p>
    </div>
  </section>

  <section id="assistente">
    <div class="container duas">
      <div>
        <p class="eyebrow">Assistente</p>
        <h2>Pergunte ao seu CRM.</h2>
        <p class="lead">Em vez de caçar telas, pergunte em português: quem está mais quente, o que fazer hoje, como foi a semana. O assistente responde com os seus dados e também explica como usar o sistema.</p>
        <p class="lead">Ele só lê. Não altera, não apaga e não envia nada.</p>
        <a class="link-seta" href="/funcionalidades/assistente-de-dados/">Conheça o assistente <Icone nome="arrow" /></a>
      </div>
      <AssistenteDemo />
    </div>
  </section>

  <section id="relatorios" class="sec-alt">
    <div class="container">
      <div class="sec-cabeca">
        <p class="eyebrow">Relatórios</p>
        <h2>Prestação de contas em um clique.</h2>
        <p class="lead">Três níveis de detalhe para três leitores diferentes. Escolha abaixo.</p>
      </div>
      <RelatorioAbas />
      <p class="nota-ficticia">{NOTA}</p>
    </div>
  </section>

  <section id="video">
    <div class="container">
      <div class="sec-cabeca centro">
        <p class="eyebrow">Ver em ação</p>
        <h2>Veja as telas reais do JR!</h2>
      </div>
      <div class="video-wrap">
        <VideoFacade />
        <p class="video-legenda">Telas reais da plataforma, com narração, legendas e trilha. {NOTA}</p>
      </div>
      <div class="celulares">
        <div class="celular"><Shot src={m1} widths={[320, 500]} sizes="250px" alt="Painel do JR! no celular, com o menu fixo embaixo" /></div>
        <div class="celular"><Shot src={m2} widths={[320, 500]} sizes="250px" alt="Funil com termômetro no celular" /></div>
        <div class="celular"><Shot src={m3} widths={[320, 500]} sizes="250px" alt="Tarefas do dia no celular" /></div>
      </div>
      <p class="nota-ficticia">No computador e no celular, com menu próprio para a tela pequena.</p>
    </div>
  </section>

  <section id="para-quem" class="sec-alt">
    <div class="container">
      <div class="sec-cabeca">
        <p class="eyebrow">Para quem é</p>
        <h2>Quem decide, quem vende e quem atende vários clientes.</h2>
      </div>
      <div class="grade g4">
        {publicos.map((p, k) => (
          <a class="cartao persona brilho" href={`/para/${p.id}/`} data-revela style={`--atraso:${k * 70}ms`}>
            <div class="icone"><Icone nome={p.data.icone as any} /></div>
            <h3>{p.data.nome}</h3>
            <p>{p.data.resumo}</p>
            <span class="link-seta">Ver como ajuda <Icone nome="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="seguranca">
    <div class="container">
      <div class="comando">
        <div>
          <p class="eyebrow">Você no comando</p>
          <h2>A IA sugere. Você decide.</h2>
          <p class="lead">Nada é enviado, curtido ou comentado automaticamente. Isso protege a sua conta do LinkedIn e o seu tom pessoal.</p>
          <a class="link-seta" href="/seguranca/">Segurança e privacidade <Icone nome="arrow" /></a>
        </div>
        <ul class="comando-lista">
          <li><Icone nome="check" /><div><b>Mensagens só com você</b><span>A IA escreve, você revisa e envia.</span></div></li>
          <li><Icone nome="eye" /><div><b>Extensão só lê</b><span>Ritmo humano, limite diário, sem ações.</span></div></li>
          <li><Icone nome="lock" /><div><b>Seus dados, só seus</b><span>Acesso separado por conta no banco.</span></div></li>
          <li><Icone nome="shield" /><div><b>Revisado</b><span>Controle de acesso, injeção e cabeçalhos verificados.</span></div></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="criador" class="sec-alt">
    <div class="container">
      <div class="criador">
        <div class="avatar" aria-hidden="true">JP<span>!</span></div>
        <div>
          <p class="eyebrow">Quem criou</p>
          <h2>Feito por quem usa todos os dias.</h2>
          <p>Sou profissional de pré-vendas (PJ) e atendo vários clientes ao mesmo tempo, prospectando por social selling: LinkedIn, e-mail, WhatsApp e reunião. Planilhas e CRMs tradicionais não davam conta de relacionamento antes de pipeline, de vários clientes no mesmo lugar nem da rotina diária de toques. Então eu criei o JR!, e uso todos os dias.</p>
          <p class="nome">Junior Pereira · Pré-vendas · <a class="link" href="/sobre/">A história</a> · <a class="link" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></p>
        </div>
      </div>
    </div>
  </section>

  <CtaFinal />
  <Faq itens={faq} />
</Base>
