---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Icone from '../../components/Icone.astro';
import Faq from '../../components/Faq.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import HeroVivo from '../../components/demo/HeroVivo.astro';
import DemoIA from '../../components/demo/DemoIA.astro';
import TermometroJogavel from '../../components/demo/TermometroJogavel.astro';
import AssistenteDemo from '../../components/demo/AssistenteDemo.astro';
import RelatorioAbas from '../../components/demo/RelatorioAbas.astro';
import { NOTA } from '../../data/site';
import { faqPage, software } from '../../lib/schema';
import { postsPublicados } from '../../lib/blog';

export async function getStaticPaths() {
  const funcs = await getCollection('funcionalidades');
  return funcs.map((f) => ({ params: { slug: f.id }, props: { f } }));
}

const { f } = Astro.props;
const d = f.data;
const { Content } = await render(f);
const todas = await getCollection('funcionalidades');
const relacionadas = d.relacionados.map((s) => todas.find((x) => x.id === s)).filter((x) => !!x);
const artigos = (await postsPublicados()).filter((p) => p.data.funcionalidade === f.id).slice(0, 3);
const url = `/funcionalidades/${f.id}/`;

const demos: Record<string, { comp: any; titulo: string; texto: string }> = {
  'termometro-de-relacionamento': { comp: TermometroJogavel, titulo: 'Experimente o termômetro', texto: 'Marque os passos conquistados e veja a nota, a faixa e a sugestão do JR! mudarem.' },
  'ia-para-mensagens-de-prospeccao': { comp: DemoIA, titulo: 'Teste a IA do JR!', texto: 'Escolha um lead fictício e um canal e veja as três versões nascerem.' },
  'assistente-de-dados': { comp: AssistenteDemo, titulo: 'Converse com o assistente', texto: 'Clique numa pergunta de exemplo.' },
  'relatorios-de-prospeccao': { comp: RelatorioAbas, titulo: 'Compare os três níveis', texto: 'Escolha o leitor e veja o relatório.' },
  'funil-automatico': { comp: HeroVivo, titulo: 'Veja o funil se mover', texto: 'Cada evento da relação move o card, soma pontos no termômetro e cria a próxima tarefa.' },
};
const demo = demos[f.id];
const Demo = demo?.comp;
---
<Base
  titulo={d.seoTitulo}
  descricao={d.descricao}
  og={`/og/funcionalidades-${f.id}.jpg`}
  ogAlt={d.titulo}
  migalhas={[{ nome: 'Início', href: '/' }, { nome: 'Funcionalidades', href: '/funcionalidades/' }, { nome: d.nome, href: url }]}
  schema={[software(d.descricao, url), faqPage(d.faq)]}
>
  <section class="pg-hero">
    <div class="fundo-grade" aria-hidden="true"></div>
    <div class="container pg-hero-grid">
      <div>
        <p class="eyebrow"><Icone nome={d.icone as any} class="eyebrow-ic" /> Funcionalidade</p>
        <h1>{d.titulo}</h1>
        <p class="lead">{d.descricao}</p>
        <div class="hero-acoes esq">
          <a class="btn btn-primario" href="/fundadores/">Quero conhecer <Icone nome="arrow" /></a>
          {demo && <a class="btn btn-sec" href="#demo">{demo.titulo}</a>}
        </div>
      </div>
      <figure class:list={['pg-hero-img', { recorte: d.recorte }]}>
        <div class="moldura"><Shot src={d.imagem} alt={d.imagemAlt} eager widths={d.recorte ? [400, 752] : [640, 960, 1400]} sizes={d.recorte ? '380px' : '(min-width: 1100px) 600px, 100vw'} /></div>
        <figcaption class="nota-ficticia">{NOTA}</figcaption>
      </figure>
    </div>
  </section>

  {Demo && (
    <section id="demo" class="sec-alt sec-destaque">
      <div class="container">
        <div class="sec-cabeca centro">
          <p class="eyebrow">Interativo</p>
          <h2>{demo.titulo}</h2>
          <p class="lead">{demo.texto}</p>
        </div>
        <div class:list={['demo-palco', { estreito: f.id === 'funil-automatico' || f.id === 'assistente-de-dados' }]}><Demo /></div>
        <p class="nota-ficticia">Demonstração com dados fictícios.</p>
      </div>
    </section>
  )}

  <section>
    <div class="container prosa">
      <Content />
    </div>
  </section>

  {artigos.length > 0 && (
    <section class="sec-alt">
      <div class="container">
        <div class="sec-cabeca"><p class="eyebrow">Para se aprofundar</p><h2>Conteúdos relacionados</h2></div>
        <div class="grade g3">
          {artigos.map((a) => (
            <a class="cartao brilho" href={`/blog/${a.id}/`}><span class="tag">{a.data.categoria}</span><h3>{a.data.titulo}</h3><p>{a.data.descricao}</p></a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class:list={[{ 'sec-alt': artigos.length === 0 }]}>
    <div class="container">
      <div class="sec-cabeca"><p class="eyebrow">Combina com</p><h2>Funciona ainda melhor junto com</h2></div>
      <div class="grade g3">
        {relacionadas.map((r) => (
          <a class="cartao brilho" href={`/funcionalidades/${r.id}/`}>
            <div class="icone"><Icone nome={r.data.icone as any} /></div>
            <h3>{r.data.nome}</h3>
            <p>{r.data.resumo}</p>
            <span class="link-seta">Ver detalhes <Icone nome="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq itens={d.faq} titulo={`Perguntas sobre ${d.nome.toLowerCase()}`} />
  <CtaFinal mensagem={`Olá, Junior! Vi a página "${d.nome}" no site do JR! e quero conhecer.`} />
</Base>
