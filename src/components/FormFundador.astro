---
// Formulario da lista de clientes fundadores. Envia para /api/lista-espera/ (funcao na Vercel).
// Se o envio falhar, oferece o WhatsApp com os dados ja escritos.
import { WHATS_NUM } from '../data/site';
import Radi from './Radi.astro';
interface Props { origem?: string; }
const { origem = 'site' } = Astro.props;
---
<form class="form-f" data-form-f action="/api/lista-espera/" method="post" data-whats={WHATS_NUM} novalidate>
  <input type="hidden" name="origem" value={origem} />
  <input type="hidden" name="t" value="" data-t />
  <div class="campo-hp" aria-hidden="true">
    <label>Não preencha <input type="text" name="confirmacao_interna" tabindex="-1" autocomplete="off" data-1p-ignore data-lpignore="true" data-form-type="other" /></label>
  </div>
  <div class="campos">
    <label class="campo">
      <span>Nome</span>
      <input name="nome" required maxlength="120" autocomplete="name" />
    </label>
    <label class="campo">
      <span>E-mail profissional</span>
      <input name="email" type="email" required maxlength="160" autocomplete="email" />
    </label>
    <label class="campo">
      <span>WhatsApp <small>(opcional)</small></span>
      <input name="whatsapp" type="tel" maxlength="30" autocomplete="tel" inputmode="tel" />
    </label>
    <label class="campo">
      <span>Você é</span>
      <select name="perfil" required>
        <option value="">Escolha…</option>
        <option>CEO ou dono(a) de empresa</option>
        <option>Gestor(a) comercial</option>
        <option>SDR, BDR ou vendedor(a)</option>
        <option>Freelancer ou PJ de pré-vendas</option>
        <option>Agência de prospecção</option>
        <option>Outro</option>
      </select>
    </label>
    <label class="campo campo-largo">
      <span>Qual é o seu maior desafio na prospecção hoje? <small>(opcional)</small></span>
      <textarea name="desafio" rows="3" maxlength="1000"></textarea>
    </label>
  </div>
  <label class="aceite">
    <input type="checkbox" name="aceite" required />
    <span>Concordo em ser contatado(a) sobre o JR! e li a <a href="/privacidade/" target="_blank">política de privacidade</a>.</span>
  </label>
  <button class="btn btn-primario" type="submit">Quero ser cliente fundador</button>
  <div class="form-ok" data-ok hidden><Radi estado="feliz" /></div>
  <p class="form-msg" role="status" aria-live="polite" data-msg></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-form-f]')) {
    const msg = form.querySelector<HTMLElement>('[data-msg]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.querySelector<HTMLInputElement>('[data-t]')!.value = String(Date.now());

    const viaWhats = (d: FormData) => {
      const texto = `Olá, Junior! Quero ser cliente fundador do JR!.\nNome: ${d.get('nome')}\nE-mail: ${d.get('email')}\nPerfil: ${d.get('perfil')}${d.get('desafio') ? `\nDesafio: ${d.get('desafio')}` : ''}`;
      return `https://wa.me/${form.dataset.whats}?text=${encodeURIComponent(texto)}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'form-msg';
      if (!form.checkValidity()) {
        const inval = form.querySelector<HTMLElement>(':invalid');
        msg.textContent = 'Confira os campos: nome, e-mail válido, perfil e o aceite são obrigatórios.';
        msg.classList.add('erro');
        inval?.focus();
        return;
      }
      const dados = new FormData(form);
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      try {
        const r = await fetch(form.action, { method: 'POST', body: dados, headers: { accept: 'application/json' } });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        msg.textContent = 'Pronto! Você está na lista de clientes fundadores. O Junior vai falar com você em breve.';
        msg.classList.add('ok');
        form.querySelector<HTMLElement>('[data-ok]')!.hidden = false;
        btn.textContent = 'Enviado';
      } catch {
        msg.innerHTML = 'Não conseguimos enviar agora. <a target="_blank" rel="noopener">Mande pelo WhatsApp</a>: seus dados já vão escritos.';
        msg.querySelector('a')!.href = viaWhats(dados);
        msg.classList.add('erro');
        btn.disabled = false;
        btn.textContent = 'Tentar de novo';
      }
    });
  }
</script>
