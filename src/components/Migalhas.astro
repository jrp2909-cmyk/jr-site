---
interface Props { itens: { nome: string; href: string }[]; }
const { itens } = Astro.props;
---
<nav class="migalhas container" aria-label="Você está em">
  <ol>
    {itens.map((i, k) => (
      <li>{k < itens.length - 1 ? <a href={i.href}>{i.nome}</a> : <span aria-current="page">{i.nome}</span>}</li>
    ))}
  </ol>
</nav>
