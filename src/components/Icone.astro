---
import { ICONES, type NomeIcone } from '../data/icones';
interface Props { nome: NomeIcone; class?: string; }
const { nome, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES[nome]}></svg>
